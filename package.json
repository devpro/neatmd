{
  "name": "neatmd",
  "version": "0.1.8",
  "description": "A fast Markdown formatter for clean and consistent documentation.",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "neatmd": "./bin/cli.js"
  },
  "scripts": {
    "start": "node ./bin/cli.js",
    "test": "node --test",
    "test:coverage": "mkdir -p coverage && node --experimental-test-coverage --test-coverage-include=\"bin/**\" --test-coverage-include=\"src/**\" --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devpro/neatmd.git"
  },
  "keywords": [
    "markdown",
    "formatter",
    "cli",
    "developer-tools"
  ],
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "author": "Bertrand THOMAS",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/devpro/neatmd/issues"
  },
  "homepage": "https://github.com/devpro/neatmd#readme"
}
