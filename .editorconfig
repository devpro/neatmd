root = true

[*]
end_of_line = lf

[*.{js,json,tf*,yml,yaml}]
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 180
trim_trailing_whitespace = true

[*.md]
indent_size = 2
indent_style = space
insert_final_newline = true
max_line_length = 240
trim_trailing_whitespace = false

[.env]
charset = utf-8
insert_final_newline = true
